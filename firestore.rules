rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.uid == uid
        && request.auth.uid == 'REPLACE_WITH_YOUR_UID';
    }
    function validLedger() {
      return request.resource.data.keys().hasAll(['schema', 'revision', 'payload', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['schema', 'revision', 'payload', 'updatedAt'])
        && request.resource.data.schema == 1
        && request.resource.data.revision is int
        && request.resource.data.payload is string
        && request.resource.data.payload.size() <= 800000
        && request.resource.data.updatedAt == request.time;
    }
    match /users/{uid}/ledger/main {
      allow read: if owner(uid);
      allow create: if owner(uid) && validLedger() && request.resource.data.revision == 1;
      allow update: if owner(uid) && validLedger()
        && request.resource.data.revision == resource.data.revision + 1;
      allow delete: if false;
    }
  }
}
